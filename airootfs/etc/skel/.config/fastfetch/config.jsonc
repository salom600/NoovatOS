{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue"
    }
  },
  "display": {
    "separator": " › "
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "wm",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "battery",
    "poweradapter",
    "locale",
    "cursor",
    "terminalfont",
    "theme",
    "icons",
    "font",
    "wallpaper",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
